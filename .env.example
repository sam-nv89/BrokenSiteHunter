# ============================================
# BrokenSite Hunter - Environment Variables
# ============================================
# Скопируйте этот файл в .env и заполните значения

# ----------------
# API Keys
# ----------------

# Google Places API (бесплатный tier: $200 кредитов/мес)
# Получить: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# Hunter.io API (опционально, для premium email enrichment)
# Получить: https://hunter.io/api_keys
# Free tier: 25 поисков/месяц
HUNTER_IO_API_KEY=

# 2Captcha API (опционально, для обхода капч при scraping)
# Получить: https://2captcha.com/enterpage
TWOCAPTCHA_API_KEY=

# ----------------
# Database
# ----------------

# PostgreSQL (для production)
# DATABASE_URL=postgresql://username:password@localhost:5432/brokensitehunter

# SQLite (для локальной разработки, по умолчанию)
DATABASE_URL=sqlite:///./database.db

# ----------------
# Scraping Settings
# ----------------

# Максимальное количество запросов в минуту (защита от бана)
MAX_REQUESTS_PER_MINUTE=30

# Минимальная задержка между запросами (секунды)
MIN_DELAY_SECONDS=2

# Максимальная задержка между запросами (секунды)
MAX_DELAY_SECONDS=5

# Ротация User-Agent
USER_AGENT_ROTATION=true

# Headless режим для Selenium (true - без GUI браузера)
HEADLESS_MODE=true

# Таймаут для загрузки страниц (секунды)
PAGE_LOAD_TIMEOUT=30

# ----------------
# Proxy Settings
# ----------------

# Использовать прокси (true/false)
USE_PROXY=false

# Прокси список (через запятую, формат: http://ip:port)
# PROXY_LIST=http://123.45.67.89:8080,http://98.76.54.32:3128

# Tor SOCKS5 proxy (если используется)
# TOR_PROXY=socks5h://127.0.0.1:9050

# ----------------
# Email Enrichment
# ----------------

# Включить WHOIS lookup для поиска email
ENABLE_WHOIS=true

# Включить email pattern guessing
ENABLE_EMAIL_GUESSING=true

# Включить SMTP verification (может быть медленным)
ENABLE_SMTP_VERIFICATION=false

# Максимальное количество email паттернов для проверки
MAX_EMAIL_PATTERNS=10

# ----------------
# Technical Audit
# ----------------

# Включить SSL проверку
ENABLE_SSL_CHECK=true

# Включить PageSpeed анализ (Google Lighthouse)
ENABLE_PAGESPEED=true

# Включить Mobile-Friendly тест
ENABLE_MOBILE_TEST=true

# Включить проверку битых ссылок (медленно)
ENABLE_BROKEN_LINKS_CHECK=false

# ----------------
# Export Settings
# ----------------

# Формат экспорта по умолчанию (csv, excel, json)
DEFAULT_EXPORT_FORMAT=csv

# Директория для экспорта файлов
EXPORT_DIR=./exports

# Включить автоматическую очистку старых файлов (дни)
AUTO_CLEANUP_DAYS=30

# ----------------
# Logging & Monitoring
# ----------------

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Директория для логов
LOG_DIR=./logs

# Telegram Bot для уведомлений (опционально)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ----------------
# Application Settings
# ----------------

# Режим разработки (true/false)
DEBUG_MODE=true

# Порт для Streamlit
STREAMLIT_PORT=8501

# Имя приложения
APP_NAME=BrokenSite Hunter

# Версия
APP_VERSION=0.1.0-alpha
